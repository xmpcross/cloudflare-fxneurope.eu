{
  "name": "fxneurope-eu",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build.py",
    "test": "python3 scripts/verify.py && node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler pages dev dist",
    "check:pages": "wrangler pages functions build functions --outdir=.pages-check",
    "deploy": "npm run build && npm test && wrangler pages deploy dist"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
