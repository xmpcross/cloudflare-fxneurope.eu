---
import logos from '@/data/technologies.json';
import translations from '@/data/technology-copy.json';
interface Props {lang:string;}
const {lang}=Astro.props;
const c=translations[lang as keyof typeof translations]??translations.en;
const groups=[logos.slice(0,4),logos.slice(4,8),logos.slice(8)];
---
<section class="shell stack-section" aria-labelledby="stack-title">
  <div class="stack-heading"><span>{c.label}</span><h2 id="stack-title">{c.title}</h2><p>{c.intro}</p></div>
  <div class="stack-groups">{groups.map((group,i)=><article><div class="stack-group-intro"><h3>{c.groups[i][0]}</h3><p>{c.groups[i][1]}</p></div><ul>{group.map(logo=><li><div class="stack-logo"><img src={logo.src} width="36" height="36" alt="" loading="lazy" /></div><span>{logo.name}</span></li>)}</ul></article>)}</div>
  <p class="stack-note">{c.note}</p>
</section>
<div class="shell stack-project-heading"><h2>{c.projects}</h2><p>{c.projectsIntro}</p></div>
<style>
.stack-section{padding-bottom:72px}
.stack-heading{display:grid;grid-template-columns:1fr 1fr;gap:5%;align-items:end;margin-bottom:40px}
.stack-heading>span{grid-column:1/-1;font-family:var(--font-mono);font-size:.78rem;color:var(--accent-ink);margin-bottom:16px}
.stack-heading h2{font-size:clamp(1.8rem,1.25rem + 1.8vw,3rem);line-height:1.1;letter-spacing:-.04em;max-width:16ch;text-wrap:balance}
.stack-heading p{color:var(--muted);font-size:1.05rem;max-width:52ch}
.stack-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.stack-groups article{background:var(--surface);border:1px solid var(--line);border-top:2px solid var(--accent);padding:28px;display:flex;flex-direction:column}
.stack-group-intro{min-height:132px}
.stack-group-intro h3{font-size:1.3rem;letter-spacing:-.025em}
.stack-group-intro p{font-size:.95rem;line-height:1.55;color:var(--muted);margin-block:14px 24px}
.stack-groups ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;list-style:none;padding:0;margin-top:auto}
.stack-groups li{display:flex;flex-direction:column;align-items:flex-start;gap:20px;background:var(--page);border:1px solid var(--line);padding:16px;font-size:.98rem;font-weight:500;transition:border-color .2s,transform .2s}
.stack-groups li:hover{border-color:var(--accent);transform:translateY(-2px)}
.stack-logo{display:grid;place-items:center;background:var(--surface);width:52px;height:52px;flex-shrink:0}
.stack-logo img{width:32px;height:32px;object-fit:contain}
.stack-note{max-width:78ch;color:var(--muted);margin:28px 0 0;font-size:.95rem;padding-left:16px;border-left:2px solid var(--accent)}
.stack-project-heading{padding-block:24px 8px;display:grid;grid-template-columns:1fr 1fr;gap:5%;align-items:end;border-top:1px solid var(--line)}
.stack-project-heading h2{font-size:clamp(1.8rem,1.25rem + 1.8vw,3rem);line-height:1.1;letter-spacing:-.04em;padding-top:48px}
.stack-project-heading p{color:var(--muted);max-width:52ch}
@media(prefers-reduced-motion:reduce){.stack-groups li{transition:none}.stack-groups li:hover{transform:none}}
@media(max-width:900px){.stack-heading,.stack-project-heading{grid-template-columns:1fr;gap:20px}.stack-groups{grid-template-columns:1fr}.stack-group-intro{min-height:0}.stack-groups ul{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:640px){.stack-groups ul{grid-template-columns:repeat(2,minmax(0,1fr))}.stack-groups article{padding:22px}.stack-section{padding-bottom:40px}.stack-project-heading h2{padding-top:32px}}
</style>
