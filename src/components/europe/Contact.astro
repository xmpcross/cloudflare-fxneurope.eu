---
import Dither from '@/components/ui/Dither.astro';
import Icon from '@/components/ui/Icon.astro';
import translations from '@/data/portfolio-copy.json';
import { company } from '@/config/portfolio';
interface Props { lang: string; }
const {lang}=Astro.props;
const c=translations[lang as keyof typeof translations] ?? translations.en;
---
<!-- Synth Contact's form-in-dither panel and contact sidebar, adapted for company enquiries. -->
<div class="shell contact-template">
  <div class="contact-dither" data-dither-host><Dither scene="silk" tone="ember" seed={14} speed={0.6} interactive class="portfolio-dither" />
    <form class="company-enquiry" action="/api/contact" method="post" data-company-contact data-success={c.emailStatus} data-sending={c.sending} data-error={c.sendError} aria-describedby="contact-note">
      <div class="contact-honeypot" aria-hidden="true"><label for="contact-bot">Leave this empty</label><input id="contact-bot" name="bot-field" autocomplete="off" tabindex="-1" /></div>
      <p class="contact-topic"><label for="contact-topic">{c.want}</label>{" "}<span><select id="contact-topic" name="subject">{c.topics.map(topic=><option>{topic}</option>)}</select><Icon name="chevron-down" class="topic-chevron" /></span></p>
      <div class="contact-fields"><div><label for="contact-name">{c.name}</label><input id="contact-name" name="name" autocomplete="name" required maxlength="150" /></div><div><label for="contact-email">{c.email}</label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" /></div><div><label for="contact-company">{c.organisation}</label><input id="contact-company" name="company" autocomplete="organization" maxlength="150" /></div><div><label for="contact-website">{c.website}</label><input id="contact-website" name="website" maxlength="200" /></div></div>
      <div class="contact-message"><label for="contact-message">{c.message}</label><textarea id="contact-message" name="body" rows="5" required maxlength="3000"></textarea></div>
      <div><button class="button" type="submit">{c.compose}<Icon name="arrow-up-right" class="size-4" /></button><p id="contact-note" class="contact-note">{c.emailNote}</p><p class="contact-note" role="status" data-contact-status tabindex="-1"></p></div>
    </form>
  </div>
  <aside class="contact-sidebar"><h2>{c.direct}</h2><dl><div><dt>{c.general}</dt><dd><a class="link" href={`mailto:${company.email}`}>{company.email}</a></dd></div><div><dt>{c.orders}</dt><dd>{c.orderNote}</dd><dd><a class="link" href="https://furfunshop.com/contact/">{c.shopSupport} ↗</a></dd></div><div><dt>{c.texts}</dt><dd><a class="link" href="sms:+37259122256">{company.phone}</a></dd></div></dl></aside>
</div>
<section class="shell contact-offices"><h2>{c.companyDetails}</h2><div><article><h3>{c.office}</h3><address>{company.address.map(line=><span>{line}</span>)}</address></article><article><h3>{company.name}</h3><p>{c.facts[2][1]}: {company.registration}</p><p>{c.facts[3][1]}: {company.vat}</p></article><article><h3>{c.nav[1]}</h3><p>{c.footer}</p><a class="text-link" href={`/${lang}/portfolio/`}>{c.more} ↗</a></article></div></section>
<script>
  const form=document.querySelector<HTMLFormElement>('[data-company-contact]');
  form?.addEventListener('submit', async event=>{
    event.preventDefault();
    if(!form.reportValidity()) return;
    const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status=form.querySelector<HTMLElement>('[data-contact-status]');
    if(!button||!status||button.disabled) return;
    const data=new FormData(form);
    button.disabled=true;
    form.setAttribute('aria-busy','true');
    status.textContent=form.dataset.sending??'';
    try {
      const response=await fetch(form.action,{method:'POST',body:data,headers:{Accept:'application/json'}});
      const result=await response.json();
      if(response.ok&&result.ok===true){
        form.reset();
        status.textContent=form.dataset.success??'';
      }else{
        status.textContent=(result.error||form.dataset.error||'')+(result.reference?` Reference: ${result.reference}`:'');
      }
    } catch {
      status.textContent=form.dataset.error??'';
    } finally {
      button.disabled=false;
      form.removeAttribute('aria-busy');
      status.focus();
    }
  });
</script>
<style>
.contact-honeypot { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
button:disabled { cursor:wait; opacity:.65; }
</style>
