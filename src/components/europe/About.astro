---
import Dither from '@/components/ui/Dither.astro';
import { company } from '@/config/portfolio';
import translations from '@/data/portfolio-copy.json';
interface Props { lang: string; }
const {lang}=Astro.props;
const c=translations[lang as keyof typeof translations] ?? translations.en;
---
<!-- Synth About structure: wide visual, split story, dithered facts, timeline and closing. -->
<div class="shell"><figure class="about-portfolio-visual"><img src="/img/portfolio/furfunshop.webp" width="1440" height="1000" alt={`Fur Fun Shop — ${c.projectType}`} loading="eager" /><figcaption><span>Fur Fun Shop</span><a href="https://furfunshop.com/">{c.visit} ↗</a></figcaption></figure></div>
<section class="about-story shell"><h2>{c.storyTitle}</h2><div>{c.story.map((p,i)=><p class:list={{'story-lead':i===0}}>{p}</p>)}</div></section>
<section class="about-facts" aria-label="FXN Europe OÜ"><Dither scene="bands" tone="ember" seed={6} speed={0.5} class="portfolio-dither" /><dl class="shell">{c.facts.map(([value,label])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
<section class="shell portfolio-process"><h2>{c.processTitle}</h2><ol>{c.steps.map(([title,body],i)=><li><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></section>
<section class="about-location"><div class="shell"><h2>{c.locationTitle}</h2><div><p>{c.locationBody}</p><address>{company.address.map(line=><span>{line}</span>)}</address><a class="text-link" href={`mailto:${company.email}`}>{company.email} ↗</a></div></div></section>
<section class="about-closing" data-dither-host><Dither scene="silk" tone="ember" seed={27} speed={0.6} interactive class="portfolio-dither" /><div class="shell"><div class="closing-panel"><h2>{c.portfolioTitle}</h2><p>{c.portfolioIntro}</p><a class="button" href={`/${lang}/portfolio/`}>{c.more} ↗</a></div></div></section>
