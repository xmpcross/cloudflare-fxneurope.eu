---
import Icon from "@/components/ui/Icon.astro";
import { faq as homeFaq } from "@/config/home";

interface Props {
  title?: string;
  items?: { q: string; a: string }[];
  id?: string;
  class?: string;
}

const { title = homeFaq.title, items = homeFaq.items, id = homeFaq.id, class: className = "pb-20 lg:pb-32" } = Astro.props;
---

<section id={id} class={className}>
  <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-8">
    <h2 class="reveal text-display-md lg:col-span-4">{title}</h2>
    <div class="grid gap-2 lg:col-span-8">
      {
        items.map((item) => (
          <details class="faq reveal bg-surface" name="faq">
            <summary class="flex cursor-pointer items-center justify-between gap-6 p-5 text-lg sm:p-6">
              {item.q}
              <Icon name="plus" class="faq-plus size-3.5 shrink-0 text-accent-ink" />
            </summary>
            <p class="max-w-2xl px-5 pb-6 text-muted sm:px-6">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary {
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-plus {
    transition: transform 0.35s var(--ease-out-expo);
  }

  .faq[open] .faq-plus {
    transform: rotate(45deg);
  }

  .faq[open] p {
    animation: faq-in 0.45s var(--ease-out-expo);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
  }
</style>
