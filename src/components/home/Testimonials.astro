---
import { Image } from "astro:assets";
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import Icon from "@/components/ui/Icon.astro";
import { testimonials } from "@/config/home";

const { items } = testimonials;
---

<section id={testimonials.id} class="py-20 lg:py-32">
  <div class="shell">
    <h2 class="reveal max-w-3xl text-display-md">{testimonials.title}</h2>

    <div
      class="reveal mt-14 flex flex-col lg:mt-20"
      role="region"
      aria-roledescription="carousel"
      aria-label="Customer stories"
      data-stories
    >
      <div class="grid" aria-live="polite" data-story-track>
        {
          items.map((item, index) => (
            <figure
              class="story col-start-1 row-start-1 grid gap-2 md:grid-cols-12"
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${items.length}`}
              data-story
              data-active={index === 0 ? "" : undefined}
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-sunken md:col-span-4 md:aspect-auto md:min-h-[24rem]">
                <Image
                  src={item.photo}
                  alt={`Portrait of ${item.name}`}
                  widths={[360, 480]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  class="story-photo absolute inset-0 size-full object-cover"
                  style={`object-position: ${item.focus ?? "50% 30%"}`}
                />
              </div>
              <div class="flex flex-col bg-surface p-6 sm:p-10 md:col-span-8 lg:p-12">
                <CompanyLogo name={item.company} class="text-xl" />
                <blockquote class="mt-10 text-[clamp(1.35rem,1.05rem+1.1vw,2.05rem)] leading-[1.25] tracking-[-0.025em]">
                  “{item.quote}”
                </blockquote>
                <figcaption class="mt-auto flex flex-wrap items-end justify-between gap-6 pt-12">
                  <span>
                    <span class="block font-medium">{item.name}</span>
                    <span class="text-muted">
                      {item.role}, {item.company}
                    </span>
                  </span>
                  <span class="bg-sunken px-4 py-3 text-right">
                    <span class="block text-3xl tracking-[-0.04em] text-accent-ink">{item.result.value}</span>
                    <span class="text-sm text-muted">{item.result.label}</span>
                  </span>
                </figcaption>
              </div>
            </figure>
          ))
        }
      </div>

      <div class="order-first mb-2 flex items-center justify-between gap-4 md:order-none md:mt-2 md:mb-0" data-story-controls hidden>
        <p class="font-mono text-sm text-muted" aria-live="polite" data-story-count>1 / {items.length}</p>
        <div class="flex gap-2">
          <button type="button" class="story-btn" aria-label="Previous story" data-story-prev>
            <Icon name="arrow-left" class="size-4" />
          </button>
          <button type="button" class="story-btn" aria-label="Next story" data-story-next>
            <Icon name="arrow-right" class="size-4" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-enhanced] .story:not([data-active]) {
    visibility: hidden;
    opacity: 0;
  }

  [data-enhanced] .story[data-active] {
    animation: story-in 0.6s var(--ease-out-expo);
  }

  .story + .story {
    margin-top: 0.5rem;
  }

  [data-enhanced] [data-story-track] {
    touch-action: pan-y;
  }

  .story[data-dragging] {
    animation: none;
    transition: none;
  }

  .story[data-settling] {
    transition: transform 0.35s var(--ease-out-expo);
  }

  [data-enhanced] .story + .story {
    margin-top: 0;
  }

  .story-photo {
    filter: grayscale(1) contrast(1.08);
  }

  [data-enhanced] .story[data-active] .story-photo {
    animation: photo-in 1.1s var(--ease-out-expo);
  }

  @keyframes story-in {
    from {
      opacity: 0;
      transform: translate(var(--from-x, 0), var(--from-y, 0.75rem));
    }
  }

  @keyframes photo-in {
    from {
      transform: scale(1.06);
    }
  }

  .story-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--surface);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .story-btn:hover {
    background: var(--ink);
    color: var(--page);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-stories]");

  if (root) {
    root.setAttribute("data-enhanced", "");
    const stories = [...root.querySelectorAll<HTMLElement>("[data-story]")];
    const count = root.querySelector<HTMLElement>("[data-story-count]");
    const controls = root.querySelector<HTMLElement>("[data-story-controls]");
    const track = root.querySelector<HTMLElement>("[data-story-track]");
    let index = 0;
    if (controls) controls.hidden = false;

    const show = (next: number, from = 0) => {
      index = (next + stories.length) % stories.length;
      stories.forEach((story, i) => {
        story.toggleAttribute("data-active", i === index);
        story.style.transform = "";
        story.style.setProperty("--from-x", from ? `${from * 3}rem` : "");
        story.style.setProperty("--from-y", from ? "0" : "");
      });
      if (count) count.textContent = `${index + 1} / ${stories.length}`;
    };

    root.querySelector("[data-story-prev]")?.addEventListener("click", () => show(index - 1));
    root.querySelector("[data-story-next]")?.addEventListener("click", () => show(index + 1));
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });

    /* The slide follows the finger; past a quarter of its width, or on a quick flick, it changes. */
    let startX = 0;
    let startY = 0;
    let startT = 0;
    let dragging: HTMLElement | undefined;

    const release = (dx: number) => {
      const story = dragging;
      dragging = undefined;
      if (!story?.hasAttribute("data-dragging")) return;
      story.removeAttribute("data-dragging");
      const flick = Math.abs(dx) > 40 && performance.now() - startT < 250;
      if (Math.abs(dx) > story.offsetWidth / 4 || flick) {
        show(index + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
        return;
      }
      story.setAttribute("data-settling", "");
      story.style.transform = "";
      story.addEventListener("transitionend", () => story.removeAttribute("data-settling"), { once: true });
    };

    track?.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      startX = event.clientX;
      startY = event.clientY;
      startT = performance.now();
      dragging = stories[index];
    });
    track?.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      if (!dragging.hasAttribute("data-dragging")) {
        if (Math.abs(dx) < 8) return;
        if (Math.abs(event.clientY - startY) > Math.abs(dx)) {
          dragging = undefined;
          return;
        }
        dragging.setAttribute("data-dragging", "");
        track.setPointerCapture(event.pointerId);
      }
      dragging.style.transform = `translateX(${dx}px)`;
    });
    track?.addEventListener("pointerup", (event) => release(event.clientX - startX));
    track?.addEventListener("pointercancel", () => release(0));
  }
</script>
