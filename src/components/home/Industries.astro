---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import { industries } from "@/config/home";
---

<section id={industries.id} class="bg-sunken py-20 lg:py-32" data-industries>
  <div class="shell">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="reveal text-display-lg lg:col-span-7">{industries.title}</h2>
      <p class="reveal text-lead text-muted lg:col-span-5">{industries.lead}</p>
    </div>

    <div class="reveal mt-14 flex flex-col gap-2 lg:mt-20 lg:h-[34rem] lg:flex-row">
      {
        industries.items.map((item, index) => (
          <article
            id={item.id}
            class="industry relative flex min-h-20 flex-col overflow-hidden bg-night text-night-ink"
            data-industry
            data-open={index === 0 ? "" : undefined}
          >
            <Image
              src={item.image}
              alt={item.imageAlt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="industry-photo absolute inset-0 size-full object-cover"
            />
            <h3 class="industry-head relative">
              <button
                type="button"
                class="industry-toggle flex w-full items-center justify-between gap-4 p-5 text-left text-2xl tracking-tight lg:p-6"
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`${item.id}-body`}
              >
                <span class="industry-name">{item.name}</span>
                <Icon name="arrow-up-right" class="industry-arrow size-5 text-accent" />
              </button>
            </h3>
            <div id={`${item.id}-body`} class="industry-body relative mt-auto p-5 lg:p-6">
              <p class="max-w-md">{item.body}</p>
              <dl class="mt-6 grid max-w-md grid-cols-2 gap-2">
                {item.metrics.map((metric) => (
                  <div class="flex flex-col bg-page p-4 text-ink">
                    <dt class="order-2 text-sm text-muted">{metric.label}</dt>
                    <dd class="order-1 mb-1 text-2xl tracking-[-0.04em]">{metric.value}</dd>
                  </div>
                ))}
              </dl>
              {item.href && (
                <a href={item.href} class="btn btn-accent btn-sm mt-6">
                  <span>{item.name} in detail</span>
                  <Icon name="arrow-up-right" class="pixel-arrow" />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .industry {
    transition: flex-grow 0.7s var(--ease-out-expo);
  }

  .industry-photo {
    filter: grayscale(1) brightness(0.55);
    transform: scale(1.04);
    transition:
      filter 0.7s,
      transform 1.2s var(--ease-out-expo);
  }

  .industry[data-open] .industry-photo {
    filter: none;
    transform: none;
  }

  .industry-head {
    background: linear-gradient(rgb(0 0 0 / 0.45), transparent);
  }

  .industry-body {
    padding-top: 6rem;
    background: linear-gradient(transparent, rgb(12 12 11 / 0.88) 45%);
  }

  [data-enhanced] .industry-body {
    display: none;
  }

  .industry[data-open] {
    min-height: 28rem;
  }

  .industry[data-open] .industry-body {
    display: block;
    animation: body-in 0.6s var(--ease-out-expo) 0.15s both;
  }

  .industry-arrow {
    transition: transform 0.4s var(--ease-out-expo);
  }

  .industry[data-open] .industry-arrow {
    transform: rotate(90deg);
  }

  @keyframes body-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media (min-width: 64rem) {
    .industry {
      flex: 1 1 0;
      min-width: 0;
      min-height: 0;
    }

    .industry[data-open] {
      flex-grow: 5;
      min-height: 0;
    }

    .industry:not([data-open]) .industry-toggle {
      height: 100%;
      flex-direction: column-reverse;
      justify-content: space-between;
      align-items: flex-start;
    }

    .industry:not([data-open]) .industry-name {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    .industry:not([data-open]) h3 {
      height: 100%;
    }

    .industry-body {
      min-width: 24rem;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-industries]");

  if (root) {
    root.setAttribute("data-enhanced", "");
    const items = [...root.querySelectorAll<HTMLElement>("[data-industry]")];
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 64rem)");
    let hoverTimer = 0;

    const open = (target: HTMLElement) => {
      items.forEach((item) => {
        const on = item === target;
        item.toggleAttribute("data-open", on);
        item.querySelector("button")?.setAttribute("aria-expanded", String(on));
      });
    };

    items.forEach((item) => {
      item.querySelector("button")?.addEventListener("click", () => open(item));
      item.addEventListener("pointerenter", () => {
        if (!finePointer.matches) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => open(item), 140);
      });
      item.addEventListener("pointerleave", () => window.clearTimeout(hoverTimer));
    });

    const fromHash = () => {
      const target = items.find((item) => `#${item.id}` === window.location.hash);
      if (target) open(target);
    };
    fromHash();
    window.addEventListener("hashchange", fromHash);
  }
</script>
