---
import { Image } from "astro:assets";
import Dither from "@/components/ui/Dither.astro";
import Logomark from "@/components/ui/Logomark.astro";
import Icon from "@/components/ui/Icon.astro";
import { hero } from "@/config/home";
import { siteConfig } from "@/config/site";

const { primary } = siteConfig.actions;
---

<section class="overflow-hidden">
  <div class="shell grid gap-8 pt-14 pb-12 lg:grid-cols-12 lg:items-end lg:gap-8 lg:pt-20 lg:pb-16">
    <h1 class="text-display-xl lg:col-span-8">
      {hero.title.map((line, i) => <span class="rise block" style={`--i:${i}`}>{line}</span>)}
    </h1>
    <div class="lg:col-span-4 lg:pb-3">
      <p class="rise text-lead text-muted" style="--i:2">{hero.lead}</p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
        <a href={primary.href} class="btn btn-accent">
          <span>{primary.label}</span>
          <Icon name="arrow-up-right" class="pixel-arrow" />
        </a>
        <a href={hero.secondary.href} class="btn btn-ghost">
          <span>{hero.secondary.label}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="shell">
    <div class="hero-stage rise relative grid overflow-hidden lg:grid-cols-12" style="--i:4" data-dither-host>
      <Dither scene="silk" tone="ember" seed={4} speed={0.6} interactive class="absolute! inset-0" />

      <div class="relative aspect-[4/3] lg:col-span-7 lg:aspect-auto lg:h-full">
        <Image
          src={hero.photo}
          alt={hero.photoAlt}
          widths={[800, 1200, 1600, 2200, 2800]}
          sizes="(min-width: 1024px) max(58vw, 72rem), (min-width: 640px) 100vw, 150vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
        />
        <div
          class="hero-toast absolute bottom-4 left-4 flex items-center gap-3 bg-surface py-3 pr-5 pl-3 shadow-[0_18px_40px_-18px_rgb(0_0_0/0.45)] sm:bottom-6 sm:left-6"
        >
          <span class="grid size-9 place-items-center bg-ink text-accent"><Icon name="check" class="size-4" stroke={2} /></span>
          <span class="text-sm leading-tight">
            <span class="block font-medium">Resolved without a hand-off</span>
            <span class="text-muted">4,912 conversations today</span>
          </span>
        </div>
      </div>

      <div class="relative flex items-center justify-center p-4 sm:p-8 lg:col-span-5 lg:p-10">
        <div class="chat flex w-full max-w-[26rem] flex-col bg-surface shadow-[0_30px_70px_-28px_rgb(0_0_0/0.45)]" data-hero-chat>
          <div class="flex items-center gap-3 bg-ink px-4 py-3.5 text-page">
            <Logomark class="size-9" />
            <span class="flex-1 leading-tight">
              <span class="block text-[0.95rem] font-medium">{siteConfig.name}</span>
              <span class="flex items-center gap-1.5 text-xs text-night-muted">
                <span class="live-dot size-1.5 bg-accent" aria-hidden="true"></span>
                Online, replies instantly
              </span>
            </span>
            <Icon name="x" class="size-4 text-night-muted" />
          </div>

          <ol class="relative grid content-start gap-3 px-4 pt-5 pb-4" aria-label="Example conversation">
            {
              hero.conversation.map((message, index) => (
                <li
                  class:list={["chat-item grid", message.from === "customer" ? "justify-items-end" : "justify-items-start"]}
                  data-step={index}
                  data-agent={message.from !== "customer" ? "" : undefined}
                >
                  {message.from === "receipt" ? (
                    <span class="flex w-[88%] items-center gap-3 bg-sunken p-3">
                      <span class="grid size-9 shrink-0 place-items-center bg-page text-accent-ink">
                        <Icon name="credit-card" class="size-[1.1rem]" />
                      </span>
                      <span class="min-w-0 flex-1 text-sm leading-tight">
                        <span class="block font-medium">{message.text}</span>
                        <span class="text-muted">{message.detail}</span>
                      </span>
                      <span class="grid size-5 place-items-center bg-accent text-on-accent">
                        <Icon name="check" class="size-3" stroke={2.5} />
                      </span>
                    </span>
                  ) : (
                    <span
                      class:list={[
                        "max-w-[85%] px-3.5 py-2.5 text-[0.9rem] leading-snug",
                        message.from === "agent" ? "bg-sunken" : "bg-ink text-page",
                      ]}
                    >
                      <span class="sr-only">{message.from === "agent" ? "Agent: " : "Customer: "}</span>
                      {message.text}
                    </span>
                  )}
                  <span class="mt-1 font-mono text-[0.65rem] text-muted">{message.time}</span>
                </li>
              ))
            }
            <li class="typing gap-1 bg-sunken px-3.5 py-3" aria-hidden="true" data-typing>
              <span></span><span></span><span></span>
            </li>
          </ol>

          <div class="mt-auto flex items-center gap-2 p-3 pt-0" aria-hidden="true">
            <span class="flex-1 bg-sunken px-3.5 py-3 text-sm text-muted">Write a message…</span>
            <span class="grid size-11 place-items-center bg-accent text-on-accent">
              <Icon name="arrow-up-right" class="size-4" stroke={2} />
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-stage {
    min-height: clamp(30rem, 50vw, 44rem);
  }

  .live-dot {
    animation: blink 1.6s steps(2, jump-none) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .typing {
    display: none;
    position: absolute;
    left: 1rem;
  }

  .typing span {
    width: 0.375rem;
    height: 0.375rem;
    background: var(--muted);
    animation: typing 0.9s infinite;
  }

  .typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing {
    50% {
      transform: translateY(-3px);
      opacity: 0.4;
    }
  }

  [data-playing] .chat-item:not([data-shown]) {
    visibility: hidden;
  }

  [data-playing] .chat-item[data-shown] {
    animation: message-in 0.45s var(--ease-out-expo);
  }

  [data-playing] .typing[data-shown] {
    display: flex;
  }

  @keyframes message-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  .hero-toast {
    animation: toast 12s var(--ease-out-expo) infinite;
  }

  @keyframes toast {
    0%,
    60% {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    66%,
    94% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-toast {
      animation: none;
    }
  }
</style>

<script>
  const chat = document.querySelector<HTMLElement>("[data-hero-chat]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (chat && !reduce) {
    const messages = [...chat.querySelectorAll<HTMLElement>("[data-step]")];
    const typing = chat.querySelector<HTMLElement>("[data-typing]");
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    chat.setAttribute("data-playing", "");

    const play = async () => {
      for (;;) {
        messages.forEach((message) => message.removeAttribute("data-shown"));
        await wait(600);
        for (const [i, message] of messages.entries()) {
          const isAgent = message.hasAttribute("data-agent");
          if (isAgent && i > 0 && typing) {
            typing.style.top = `${message.offsetTop}px`;
            typing.setAttribute("data-shown", "");
            await wait(1100);
            typing.removeAttribute("data-shown");
          }
          message.setAttribute("data-shown", "");
          await wait(isAgent ? 1300 : 1000);
        }
        await wait(3600);
      }
    };

    void play();
  }
</script>
