---
interface Props {
  text: string;
  class?: string;
  /** Accessible name. Left off, the word is decorative. */
  label?: string;
}

const { text, class: className, label } = Astro.props;

/* 5x7 glyphs, one string of 35 bits per character, row by row. */
const font: Record<string, string> = {
  A: "01110100011000111111100011000110001",
  B: "11110100011000111110100011000111110",
  C: "01111100001000010000100001000001111",
  D: "11110100011000110001100011000111110",
  E: "11111100001000011110100001000011111",
  F: "11111100001000011110100001000010000",
  G: "01111100001000010011100011000101111",
  H: "10001100011000111111100011000110001",
  I: "11111001000010000100001000010011111",
  J: "00111000100001000010000101001001100",
  K: "10001100101010011000101001001010001",
  L: "10000100001000010000100001000011111",
  M: "10001110111010110101100011000110001",
  N: "10001110011010110011100011000110001",
  O: "01110100011000110001100011000101110",
  P: "11110100011000111110100001000010000",
  Q: "01110100011000110001101011001001101",
  R: "11110100011000111110101001001010001",
  S: "01111100001000001110000010000111110",
  T: "11111001000010000100001000010000100",
  U: "10001100011000110001100011000101110",
  V: "10001100011000110001100010101000100",
  W: "10001100011000110101101011101110001",
  X: "10001100010101000100010101000110001",
  Y: "10001100010101000100001000010000100",
  Z: "11111000010001000100010001000011111",
  "0": "01110100011001110101110011000101110",
  "1": "00100011000010000100001000010001110",
  "2": "01110100010000100010001000100011111",
  "3": "11110000010000101110000010000111110",
  "4": "00010001100101010010111110001000010",
  "5": "11111100001111000001000011000101110",
  "6": "00110010001000011110100011000101110",
  "7": "11111000010001000100010000100001000",
  "8": "01110100011000101110100011000101110",
  "9": "01110100011000101111000010001001100",
  " ": "00000000000000000000000000000000000",
};

const chars = [...text.toUpperCase()].filter((ch) => ch in font);
const width = chars.length * 6 - 1;
const pixels = chars.flatMap((ch, index) =>
  [...font[ch]].flatMap((bit, i) => (bit === "1" ? [{ x: index * 6 + (i % 5), y: Math.floor(i / 5) }] : [])),
);
---

<svg
  viewBox={`0 0 ${width} 7`}
  class:list={["pixel-word", className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {
    pixels.map(({ x, y }) => (
      <rect x={x + 0.06} y={y + 0.06} width="0.88" height="0.88" style={`--d:${((x * 7 + y * 13) % 23) * 28}ms`} />
    ))
  }
</svg>

<style>
  .pixel-word {
    display: block;
    width: 100%;
    height: auto;
    fill: currentColor;
  }

  .pixel-word rect {
    transition:
      fill 0.25s,
      opacity 0.5s var(--ease-out-expo);
    transition-delay: var(--d);
  }

  @supports (animation-timeline: view()) {
    .pixel-word rect {
      animation: pixel-in linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 40%;
    }
  }

  @keyframes pixel-in {
    from {
      opacity: 0;
    }
  }

  .pixel-word:hover rect {
    fill: var(--accent);
  }
</style>
