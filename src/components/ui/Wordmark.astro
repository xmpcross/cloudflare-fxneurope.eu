---
import logo from "@/assets/brand/logo.svg?raw";
import { siteConfig } from "@/config/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={["inline-flex h-6 [&>svg]:h-full [&>svg]:w-auto", className]}
  role="img"
  aria-label={siteConfig.name}
  set:html={logo}
/>
