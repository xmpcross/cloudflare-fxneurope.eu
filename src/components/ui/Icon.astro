---
const bootstrap = import.meta.glob<string>("/src/icons/bootstrap/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const lucide = import.meta.glob<string>("/src/icons/lucide/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

/* Lucide ships 24px outlines at stroke 2; the theme draws them lighter. */
const outline = Object.fromEntries(
  Object.entries(lucide).map(([file, svg]) => [
    file.replace(/^.*\/|\.svg$/g, ""),
    svg
      .replace(/<!--[\s\S]*?-->/, "")
      .replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(width|height|class)="[^"]*"/g, ""))
      .replace('stroke-width="2"', 'stroke-width="1.5"'),
  ]),
);

/* Filled brand marks, addressed as `social-<file name>`, e.g. `social-twitter-x`. */
const brands: Record<string, string> = Object.fromEntries(
  Object.entries(bootstrap).map(([file, svg]) => [
    `social-${file.replace(/^.*\/|\.svg$/g, "")}`,
    svg.replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(width|height|class)="[^"]*"/g, "")),
  ]),
);

export type IconName = string;

interface Props {
  name: IconName;
  class?: string;
  /** Stroke width for outline icons. */
  stroke?: number;
}

const { name, class: className = "size-4", stroke } = Astro.props;
let svg = brands[name] ?? outline[name] ?? outline.link;
if (stroke && !brands[name]) svg = svg.replace('stroke-width="1.5"', `stroke-width="${stroke}"`);
---

<span class:list={["icon shrink-0 place-items-center [&>svg]:size-full", className]} aria-hidden="true" set:html={svg} />

<style is:global>
  .icon:not(.hidden) {
    display: inline-grid;
  }
</style>
