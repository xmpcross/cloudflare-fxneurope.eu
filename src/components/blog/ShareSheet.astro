---
import Icon from "@/components/ui/Icon.astro";

/**
 * One native `<dialog>` per page, opened by any `[data-share-open]` control.
 * Every target is a plain link, so sharing works even without the clipboard.
 */
interface Props {
  title: string;
  /** Absolute URL of the page being shared. */
  url: string;
}

const { title, url } = Astro.props;
const link = encodeURIComponent(url);
const text = encodeURIComponent(title);

/* Each service keeps its own colour so a reader finds theirs at a glance. */
const targets = [
  { label: "X", icon: "social-twitter-x", brand: "#0e0e0c", href: `https://x.com/intent/post?text=${text}&url=${link}` },
  { label: "LinkedIn", icon: "social-linkedin", brand: "#0a66c2", href: `https://www.linkedin.com/sharing/share-offsite/?url=${link}` },
  { label: "Facebook", icon: "social-facebook", brand: "#1877f2", href: `https://www.facebook.com/sharer/sharer.php?u=${link}` },
  { label: "Email", icon: "social-envelope", brand: "#c2413f", href: `mailto:?subject=${text}&body=${link}` },
  { label: "WhatsApp", icon: "social-whatsapp", brand: "#1eb355", href: `https://api.whatsapp.com/send?text=${text}%20${link}` },
  { label: "Telegram", icon: "social-telegram", brand: "#2596d8", href: `https://t.me/share/url?url=${link}&text=${text}` },
  { label: "Threads", icon: "social-threads", brand: "#0e0e0c", href: `https://www.threads.net/intent/post?text=${text}%20${link}` },
];

const extraTargets = [
  { label: "Bluesky", icon: "social-bluesky", brand: "#1185fe", href: `https://bsky.app/intent/compose?text=${text}%20${link}` },
  { label: "Mastodon", icon: "social-mastodon", brand: "#5a5bd6", href: `https://mastodonshare.com/?text=${text}&url=${link}` },
  { label: "Reddit", icon: "social-reddit", brand: "#e03d00", href: `https://www.reddit.com/submit?url=${link}&title=${text}` },
  { label: "Pinterest", icon: "social-pinterest", brand: "#d5001f", href: `https://pinterest.com/pin/create/button/?url=${link}&description=${text}` },
];
---

<dialog class="sheet" aria-labelledby="share-title" data-share-sheet>
  <div class="sheet-panel bg-surface p-6 sm:p-7">
    <div class="flex items-center justify-between gap-4">
      <h2 id="share-title" class="text-xl tracking-tight">Share this post</h2>
      <button type="button" class="grid size-10 place-items-center bg-sunken hover:bg-line" aria-label="Close sharing options" data-share-close>
        <Icon name="x" class="size-4" />
      </button>
    </div>

    <ul class="sheet-targets mt-6">
      {
        targets.map((target) => (
          <li>
            <a class="sheet-target" style={`--brand:${target.brand}`} href={target.href} target="_blank" rel="noopener noreferrer" data-share-target>
              <span class="sheet-icon"><Icon name={target.icon} class="size-5" /></span>
              <span class="text-sm">{target.label}</span>
            </a>
          </li>
        ))
      }
      <li data-share-more-item>
        <button type="button" class="sheet-target sheet-target-quiet" data-share-more>
          <span class="sheet-icon"><Icon name="social-three-dots" class="size-5" /></span>
          <span class="text-sm">More</span>
        </button>
      </li>
      {
        extraTargets.map((target) => (
          <li hidden data-share-extra>
            <a class="sheet-target" style={`--brand:${target.brand}`} href={target.href} target="_blank" rel="noopener noreferrer" data-share-target>
              <span class="sheet-icon"><Icon name={target.icon} class="size-5" /></span>
              <span class="text-sm">{target.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-7">
      <label for="share-url" class="text-sm text-muted">Page link</label>
      <div class="mt-2 flex bg-sunken">
        <input id="share-url" class="min-w-0 flex-1 bg-transparent px-3 py-3 font-mono text-[0.8rem] text-muted outline-none" type="text" readonly value={url} data-share-url />
        <button type="button" class="flex items-center gap-2 bg-ink px-4 text-sm text-page hover:bg-accent hover:text-on-accent" data-share-copy>
          <Icon name="copy" class="size-4" />
          <span aria-live="polite" data-share-copy-label>Copy</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .sheet {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 1.25rem;
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  .sheet[open] {
    display: grid;
    place-items: center;
  }

  .sheet::backdrop {
    background: rgb(12 12 11 / 0.55);
  }

  .sheet-panel {
    width: 100%;
    max-width: 27rem;
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.35);
  }

  .sheet[open] .sheet-panel {
    animation: sheet-in 0.4s var(--ease-out-expo);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  .sheet-targets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem 0.5rem;
  }

  .sheet-targets li[hidden] {
    display: none;
  }

  .sheet-target {
    display: grid;
    width: 100%;
    justify-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-align: center;
  }

  .sheet-target:hover {
    color: var(--ink);
  }

  .sheet-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    background: var(--brand);
    color: #fff;
    transition: transform 0.25s var(--ease-out-expo);
  }

  .sheet-target-quiet .sheet-icon {
    background: var(--sunken);
    color: var(--ink);
  }

  .sheet-target:hover .sheet-icon {
    transform: translateY(-2px);
  }

  :global(html.has-open-share) {
    overflow: hidden;
  }
</style>

<script>
  const sheet = document.querySelector<HTMLDialogElement>("[data-share-sheet]");

  if (sheet && typeof sheet.showModal === "function") {
    let opener: HTMLElement | null = null;
    const close = () => sheet.open && sheet.close();

    document.querySelectorAll<HTMLButtonElement>("[data-share-open]").forEach((button) => {
      button.hidden = false;
      button.addEventListener("click", () => {
        opener = button;
        sheet.showModal();
        document.documentElement.classList.add("has-open-share");
      });
    });

    sheet.addEventListener("close", () => {
      document.documentElement.classList.remove("has-open-share");
      opener?.focus({ preventScroll: true });
      opener = null;
    });

    sheet.addEventListener("click", (event) => {
      if (event.target === sheet) close();
    });
    sheet.querySelector("[data-share-close]")?.addEventListener("click", close);
    sheet.querySelectorAll("[data-share-target]").forEach((target) => target.addEventListener("click", close));

    sheet.querySelector("[data-share-more]")?.addEventListener("click", () => {
      sheet.querySelectorAll<HTMLElement>("[data-share-extra]").forEach((item) => (item.hidden = false));
      const more = sheet.querySelector<HTMLElement>("[data-share-more-item]");
      if (more) more.hidden = true;
      sheet.querySelector<HTMLElement>("[data-share-extra] a")?.focus();
    });

    const copy = sheet.querySelector<HTMLButtonElement>("[data-share-copy]");
    const label = sheet.querySelector<HTMLElement>("[data-share-copy-label]");
    const field = sheet.querySelector<HTMLInputElement>("[data-share-url]");
    let restore = 0;

    copy?.addEventListener("click", async () => {
      if (!field || !label) return;
      let message = "Copied";
      try {
        await navigator.clipboard.writeText(field.value);
      } catch {
        field.select();
        message = "Press Ctrl+C";
      }
      label.textContent = message;
      window.clearTimeout(restore);
      restore = window.setTimeout(() => (label.textContent = "Copy"), 2400);
    });
  }
</script>
