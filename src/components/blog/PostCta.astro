---
import Dither from "@/components/ui/Dither.astro";
import Icon from "@/components/ui/Icon.astro";
import { postCta } from "@/config/blog";
import { siteConfig } from "@/config/site";

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  label?: string;
  href?: string;
  /** On a post page, moves the band below this many `##` sections of the article. */
  after?: number;
}

const {
  eyebrow = postCta.eyebrow,
  title = postCta.title,
  body = postCta.body,
  label = siteConfig.actions.primary.label,
  href = siteConfig.actions.primary.href,
  after,
} = Astro.props;
---

<aside class="post-cta relative overflow-hidden p-3 text-base leading-normal sm:p-5" data-dither-host data-after={after}>
  <Dither scene="silk" tone="ember" seed={title.length} speed={0.5} interactive class="absolute! inset-0" />
  <div class="relative grid gap-6 bg-page/95 p-5 sm:p-7 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
    <div>
      <p class="mono-meta text-accent-ink!">{eyebrow}</p>
      <p class="mt-3 text-title">{title}</p>
      <p class="mt-2 max-w-lg text-muted">{body}</p>
    </div>
    <a href={href} class="btn btn-accent justify-self-start">
      <span>{label}</span>
      <Icon name="arrow-up-right" class="pixel-arrow" />
    </a>
  </div>
</aside>
{
  after && (
    <script is:inline>
      (() => {
        const cta = document.currentScript.previousElementSibling;
        const next = document.querySelectorAll(".prose > h2")[Number(cta.dataset.after)];
        if (next) next.before(cta);
      })();
    </script>
  )
}

<style>
  .post-cta {
    margin-top: 3.5rem;
  }

  /* Moved into the article: beats `.prose > * + *`, which is unlayered. */
  :global(.prose) > .post-cta {
    margin-block: 3rem;
  }
</style>
