---
import { Image } from "astro:assets";
import TeamGlobe from "@/components/about/TeamGlobe.astro";
import Dither from "@/components/ui/Dither.astro";
import Icon from "@/components/ui/Icon.astro";
import { about } from "@/config/about";
import { careers } from "@/config/careers";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { primary } = siteConfig.actions;
---

<BaseLayout title="About" description={about.lead}>
  <section class="shell pt-14 pb-12 lg:pt-20 lg:pb-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <h1 class="rise text-display-xl lg:col-span-8">{about.title}</h1>
      <div class="lg:col-span-4 lg:pb-3">
        <p class="rise text-lead text-muted" style="--i:1">{about.lead}</p>
        <div class="rise mt-8 flex flex-wrap gap-3" style="--i:2">
          <a href={about.closing.cta.href} class="btn btn-accent">
            <span>{about.closing.cta.label}</span>
            <Icon name="arrow-up-right" class="pixel-arrow" />
          </a>
          <a href={primary.href} class="btn btn-ghost">
            <span>{primary.label}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="shell">
    <figure class="rise relative aspect-4/3 overflow-hidden sm:aspect-video lg:aspect-21/9" style="--i:3">
      <Image
        src={about.photo}
        alt={about.photoAlt}
        widths={[640, 960, 1400, 2000]}
        sizes="(min-width: 1344px) 84rem, 100vw"
        loading="eager"
        class="absolute inset-0 size-full object-cover"
      />
    </figure>
  </div>

  <section class="py-20 lg:py-32" aria-labelledby="story-title">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-8">
      <h2 id="story-title" class="reveal text-display-md lg:col-span-4">{about.story.title}</h2>
      <div class="grid gap-6 lg:col-span-7 lg:col-start-6">
        {
          about.story.paragraphs.map((paragraph, i) => (
            <p class:list={["reveal", i === 0 ? "text-title" : "text-lead text-muted"]}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-16 lg:py-24" aria-label="Synth in numbers">
    <Dither scene="bands" tone="ember" seed={6} speed={0.5} class="absolute! inset-0" />
    <div class="shell relative">
      <dl class="grid grid-cols-2 gap-2 lg:grid-cols-4">
        {
          about.facts.map((fact) => (
            <div class="reveal flex min-h-40 flex-col bg-page/95 p-5 sm:min-h-48 sm:p-6 lg:min-h-56 lg:p-8">
              <dt class="order-2 mt-auto pt-8 text-muted">{fact.label}</dt>
              <dd class="order-1 text-[clamp(2.75rem,2rem+2.4vw,4.25rem)] leading-none tracking-[-0.05em]">
                {fact.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="py-20 lg:py-32" aria-labelledby="milestones-title">
    <div class="shell">
      <h2 id="milestones-title" class="reveal text-display-md">{about.milestonesTitle}</h2>
      <ol class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5">
        {
          about.milestones.map((milestone, i) => (
            <li
              class:list={[
                "reveal border-t-2 pt-5",
                i === about.milestones.length - 1 ? "border-accent" : "border-line",
              ]}
            >
              <span class="font-mono text-sm text-muted">{milestone.year}</span>
              <h3 class="mt-6 text-lg font-medium tracking-tight">{milestone.title}</h3>
              <p class="mt-2 text-muted">{milestone.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-sunken py-20 lg:py-32" aria-labelledby="leadership-title">
    <div class="shell">
      <h2 id="leadership-title" class="reveal text-center text-display-md">{about.leadershipTitle}</h2>
      <ul class="mt-12 grid grid-cols-2 gap-2 lg:mt-16 lg:grid-cols-4">
        {
          about.leadership.map((person) => (
            <li class="reveal group flex flex-col bg-page">
              <div class="relative aspect-4/5 overflow-hidden">
                <Image
                  src={person.photo}
                  alt={`Portrait of ${person.name}`}
                  widths={[320, 480, 720]}
                  sizes="(min-width: 1024px) 21rem, 50vw"
                  class="leader-photo absolute inset-0 size-full object-cover object-top"
                />
              </div>
              <div class="flex flex-1 flex-col p-4 sm:p-5">
                <span class="text-[1.05rem] font-medium">{person.name}</span>
                <span class="mt-0.5 text-sm text-muted sm:text-base">{person.role}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <TeamGlobe />

  <section class="relative overflow-hidden py-16 sm:py-24" data-dither-host>
    <Dither scene="silk" tone="ember" seed={27} speed={0.6} interactive class="absolute! inset-0" />
    <div class="shell relative">
      <div class="reveal mx-auto grid max-w-5xl bg-page lg:grid-cols-12">
        <div class="p-6 sm:p-10 lg:col-span-8 lg:p-14">
          <h2 class="text-display-lg">{about.closing.title}</h2>
          <p class="mt-6 max-w-lg text-lead text-muted">{about.closing.body}</p>
          <a href={about.closing.cta.href} class="btn btn-accent mt-10">
            <span>{about.closing.cta.label}</span>
            <Icon name="arrow-up-right" class="pixel-arrow" />
          </a>
        </div>
        <dl class="grid grid-cols-3 gap-px bg-line lg:col-span-4 lg:grid-cols-1">
          {
            [{ value: String(careers.roles.length), label: "open roles" }, ...about.closing.proof].map((item) => (
              <div class="flex flex-col justify-center bg-sunken p-5 lg:px-8">
                <dt class="order-2 text-sm text-muted">{item.label}</dt>
                <dd class="order-1 text-2xl tracking-[-0.04em] sm:text-3xl">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .leader-photo {
    filter: grayscale(1) contrast(1.08);
    transition: transform 0.8s var(--ease-out-expo);
  }

  .group:hover .leader-photo {
    transform: scale(1.03);
  }
</style>

