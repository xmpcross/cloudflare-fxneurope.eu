---
import Dither from "@/components/ui/Dither.astro";
import Icon from "@/components/ui/Icon.astro";
import { contact } from "@/config/contact";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const live = siteConfig.contact.enabled && siteConfig.contact.action.trim() !== "";
const fieldClass =
  "h-12 w-full min-w-0 bg-sunken px-4 outline-none placeholder:text-muted focus-visible:outline-2 focus-visible:outline-accent";
---

<BaseLayout title="Contact" description={contact.lead}>
  <section class="shell pt-14 pb-12 lg:pt-20 lg:pb-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <h1 class="rise text-display-xl lg:col-span-8">{contact.title}</h1>
      <p class="rise text-lead text-muted lg:col-span-4 lg:pb-3" style="--i:1">{contact.lead}</p>
    </div>
  </section>

  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="rise relative overflow-hidden lg:col-span-7" style="--i:2" data-dither-host>
      <Dither scene="silk" tone="ember" seed={14} speed={0.6} interactive class="absolute! inset-0" />

      <form
        class="relative m-2 grid gap-6 bg-page p-6 sm:m-8 sm:p-10"
        action={live ? siteConfig.contact.action : undefined}
        method={siteConfig.contact.method}
        aria-describedby={live ? undefined : "contact-note"}
      >
        <p class="text-title">
          <label for="contact-topic">I’d like to</label>
          <span class="topic relative ml-1.5 inline-flex items-center">
            <select
              id="contact-topic"
              name="topic"
              class="topic-select appearance-none bg-transparent pr-7 text-accent-ink outline-none focus-visible:outline-2 focus-visible:outline-accent"
              data-contact-topic
            >
              {contact.topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
            </select>
            <Icon name="chevron-down" class="pointer-events-none absolute right-0 size-5 text-accent-ink" />
          </span>
        </p>

        <div class="grid gap-6 sm:grid-cols-2">
          <div class="grid gap-2">
            <label for="contact-name" class="text-sm font-medium">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required class={fieldClass} />
          </div>
          <div class="grid gap-2">
            <label for="contact-email" class="text-sm font-medium">Work email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@company.com"
              required
              class={fieldClass}
            />
          </div>
          <div class="grid gap-2">
            <label for="contact-company" class="text-sm font-medium">Company</label>
            <input id="contact-company" name="company" type="text" autocomplete="organization" class={fieldClass} />
          </div>
          <div class="grid gap-2">
            <label for="contact-size" class="text-sm font-medium">Support team size</label>
            <div class="relative">
              <select id="contact-size" name="team_size" class:list={[fieldClass, "appearance-none pr-10"]}>
                <option value="">Choose one</option>
                {contact.teamSizes.map((size) => <option>{size}</option>)}
              </select>
              <Icon name="chevron-down" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-muted" />
            </div>
          </div>
        </div>

        <div class="grid gap-2">
          <label for="contact-message" class="text-sm font-medium">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="Your channels, monthly volume, and what you would like the agent to handle first."
            class:list={[fieldClass, "h-auto resize-y py-3"]}></textarea>
        </div>

        <div class="grid gap-3">
          <button type="submit" class="btn btn-accent justify-self-start disabled:cursor-not-allowed disabled:opacity-60" disabled={!live}>
            <span>Send message</span>
            <Icon name="arrow-up-right" class="pixel-arrow" />
          </button>
          {
            !live && (
              <p id="contact-note" class="text-sm text-muted">
                The form is off in this preview. Connect a form endpoint in the site config to turn it on.
              </p>
            )
          }
        </div>
      </form>
    </div>

    <div class="lg:col-span-4 lg:col-start-9">
      <h2 class="reveal text-sm text-muted">{contact.routesTitle}</h2>
      <dl class="mt-5 grid">
        {
          contact.routes.map((route) => (
            <div class="reveal grid gap-1 border-t border-line py-5">
              <dt class="font-medium">{route.label}</dt>
              <dd class="text-muted">{route.detail}</dd>
              <dd class="mt-1">
                <a href={`mailto:${route.email}`} class="link">
                  {route.email}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <section class="py-20 lg:py-32" aria-labelledby="offices-title">
    <div class="shell">
      <h2 id="offices-title" class="reveal text-display-md">{contact.officesTitle}</h2>
      <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-3 lg:mt-16">
        {
          contact.offices.map((office) => (
            <li class="reveal border-t-2 border-line pt-5">
              <h3 class="text-lg font-medium tracking-tight">{office.city}</h3>
              <address class="mt-4 text-muted not-italic">
                {office.address.map((line) => (
                  <span class="block">{line}</span>
                ))}
              </address>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .topic-select {
    field-sizing: content;
    max-width: 100%;
    border-bottom: 2px solid var(--accent);
    cursor: pointer;
  }

  .topic-select option {
    color: var(--ink);
    font-size: 1rem;
  }
</style>

<script>
  const topic = new URLSearchParams(window.location.search).get("topic");
  const select = document.querySelector<HTMLSelectElement>("[data-contact-topic]");
  if (select && topic && [...select.options].some((option) => option.value === topic)) select.value = topic;
</script>
