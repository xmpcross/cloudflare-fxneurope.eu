---
import Closing from "@/components/home/Closing.astro";
import Faq from "@/components/home/Faq.astro";
import BillingToggle from "@/components/pricing/BillingToggle.astro";
import CompareTable from "@/components/pricing/CompareTable.astro";
import PlanCards from "@/components/pricing/PlanCards.astro";
import { pricing } from "@/config/pricing";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Pricing" description={pricing.lead}>
  <section class="shell pt-14 pb-12 lg:pt-20 lg:pb-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <h1 class="rise text-display-xl lg:col-span-8">{pricing.title}</h1>
      <div class="lg:col-span-4 lg:pb-3">
        <p class="rise text-lead text-muted" style="--i:1">{pricing.lead}</p>
        <BillingToggle class="rise mt-8" />
      </div>
    </div>
  </section>

  <section class="shell" aria-label="Plans">
    <PlanCards />
  </section>

  <section class="shell py-16 lg:py-24" aria-label={pricing.compareTitle}>
    <CompareTable />
  </section>

  <Faq id="pricing-faq" title={pricing.faq.title} items={pricing.faq.items} />

  <Closing />
</BaseLayout>
