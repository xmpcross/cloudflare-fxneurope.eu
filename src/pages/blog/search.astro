---
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPosts, joinNames, postAuthors, postHref } from "@/lib/posts";

const posts = await getPosts();
---

<BaseLayout title="Search" description="Search every post on the blog." noindex>
  <section class="shell pt-14 pb-24 lg:pt-20 lg:pb-32">
    <h1 class="text-display-lg">Search</h1>
    <form class="mt-10 flex max-w-2xl items-center gap-3 bg-surface px-5" role="search" action="/blog/search/" data-search-page>
      <Icon name="search" class="size-4 text-muted" />
      <label for="search-page-input" class="sr-only">Search posts</label>
      <input
        id="search-page-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Search posts, topics, authors"
        class="h-16 min-w-0 flex-1 bg-transparent text-lg outline-none placeholder:text-muted"
      />
    </form>
    <p class="mt-8 text-muted" aria-live="polite" data-search-summary>{posts.length} posts</p>
    <ol class="mt-6 grid max-w-3xl gap-2" data-search-list>
      {
        posts.map((post) => (
          <li data-href={postHref(post)}>
            <a href={postHref(post)} class="group block bg-surface p-5">
              <span class="block text-lg font-medium group-hover:text-accent-ink">{post.data.title}</span>
              <span class="mono-meta mt-1.5 block">
                {post.data.topic} · {formatDate(post.data.date)} · {joinNames(postAuthors(post))}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<script>
  import { rankPosts, type SearchItem } from "@/lib/search";

  const form = document.querySelector<HTMLFormElement>("[data-search-page]");
  const input = form?.querySelector("input");
  const list = document.querySelector<HTMLOListElement>("[data-search-list]");
  const summary = document.querySelector<HTMLElement>("[data-search-summary]");
  const rows = [...(list?.querySelectorAll<HTMLLIElement>("li") ?? [])];
  let index: SearchItem[] | null = null;

  const run = async () => {
    if (!input || !list || !summary) return;
    const query = input.value.trim();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);

    if (!query) {
      rows.forEach((row) => (row.hidden = false));
      summary.textContent = `${rows.length} posts`;
      return;
    }
    index ??= await fetch("/search-index.json")
      .then((response) => response.json() as Promise<SearchItem[]>)
      .catch(() => []);
    const ranked = rankPosts(index, query).map((item) => item.href);
    rows.forEach((row) => (row.hidden = !ranked.includes(row.dataset.href ?? "")));
    ranked.forEach((href) => {
      const row = rows.find((item) => item.dataset.href === href);
      if (row) list.append(row);
    });
    summary.textContent = ranked.length
      ? `${ranked.length} result${ranked.length === 1 ? "" : "s"} for “${query}”`
      : `No posts match “${query}”.`;
  };

  if (input) {
    input.value = new URLSearchParams(window.location.search).get("q") ?? "";
    input.addEventListener("input", run);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      void run();
    });
    if (input.value) void run();
  }
</script>
