---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BlogHeader from "@/components/blog/BlogHeader.astro";
import Pagination from "@/components/blog/Pagination.astro";
import PostCard from "@/components/blog/PostCard.astro";
import { POSTS_PER_PAGE } from "@/config/blog";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, leadPost } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const lead = leadPost(posts);
  const ordered = lead ? [lead, ...posts.filter((post) => post !== lead)] : posts;
  return paginate(ordered, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const posts = page.data;
const first = page.currentPage === 1;
const [lead, ...rest] = first ? posts : [undefined, ...posts];
const description = `Engineering notes, research and playbooks from the team building ${siteConfig.name}.`;
---

<BaseLayout
  title={first ? "Blog" : `Blog, page ${page.currentPage}`}
  description={description}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
>
  <BlogHeader title="Blog" description={description} />
  <div class="shell pb-24 lg:pb-32">
    {lead && <PostCard post={lead} variant="lead" headingLevel="h2" eager />}
    {
      rest.length > 0 && (
        <div class:list={["grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3", lead && "mt-20 lg:mt-24"]}>
          {rest.map((post) => post && <PostCard post={post} headingLevel="h2" />)}
        </div>
      )
    }
    {posts.length === 0 && <p class="text-lead text-muted">No posts yet.</p>}
    <Pagination
      current={page.currentPage}
      last={page.lastPage}
      base="/blog/"
    />
  </div>
</BaseLayout>
