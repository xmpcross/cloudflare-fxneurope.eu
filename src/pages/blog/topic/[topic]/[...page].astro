---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BlogHeader from "@/components/blog/BlogHeader.astro";
import Pagination from "@/components/blog/Pagination.astro";
import PostCard from "@/components/blog/PostCard.astro";
import { POSTS_PER_PAGE, topicDescriptions, topics, topicSlug } from "@/config/blog";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, topicHref } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return topics.flatMap((topic) =>
    paginate(
      posts.filter((post) => post.data.topic === topic),
      { params: { topic: topicSlug(topic) }, props: { topic }, pageSize: POSTS_PER_PAGE },
    ),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, topic } = Astro.props as Props;
const posts = page.data;
---

<BaseLayout
  title={page.currentPage === 1 ? topic : `${topic}, page ${page.currentPage}`}
  description={topicDescriptions[topic]}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
>
  <BlogHeader title={topic} description={topicDescriptions[topic]} topic={topic} />
  <div class="shell pb-24 lg:pb-32">
    {
      posts.length > 0 ? (
        <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => (
            <PostCard post={post} headingLevel="h2" eager={i === 0} />
          ))}
        </div>
      ) : (
        <p class="text-lead text-muted">
          Nothing filed under {topic} yet. <a href="/blog/" class="link">See every post</a>.
        </p>
      )
    }
    <Pagination current={page.currentPage} last={page.lastPage} base={topicHref(topic)} />
  </div>
</BaseLayout>
