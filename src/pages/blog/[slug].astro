---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import AuthorCard from "@/components/blog/AuthorCard.astro";
import Byline from "@/components/blog/Byline.astro";
import PostCard from "@/components/blog/PostCard.astro";
import PostCta from "@/components/blog/PostCta.astro";
import ShareSheet from "@/components/blog/ShareSheet.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  postAuthors,
  formatDate,
  getPosts,
  postHref,
  postSlug,
  relatedPosts,
  topicHref,
} from "@/lib/posts";
import { articleSchema } from "@/lib/schema";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: { post, newer: posts[index - 1], older: posts[index + 1], related: relatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, newer, older, related } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, cover, coverAlt, coverCredit, topic, date, updated, tags, cta } = post.data;
/* h2s at the top level, each h3 under the h2 before it. */
const toc = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .reduce<{ slug: string; text: string; children: { slug: string; text: string }[] }[]>((items, heading) => {
    if (heading.depth === 2 || items.length === 0) items.push({ slug: heading.slug, text: heading.text, children: [] });
    else items[items.length - 1].children.push({ slug: heading.slug, text: heading.text });
    return items;
  }, []);
const names = postAuthors(post);
const url = new URL(postHref(post), siteConfig.siteUrl).toString();
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  type="article"
  structuredData={articleSchema(post, cover.src)}
>
  <div class="read-progress fixed inset-x-0 top-(--header-h) z-40 h-0.5 origin-left bg-accent" aria-hidden="true" data-progress></div>

  <article>
    <header class="shell pt-12 lg:pt-20">
      <div class="max-w-5xl">
        <p class="rise mono-meta flex flex-wrap items-center gap-x-3">
          <a href={topicHref(topic)} class="text-accent-ink hover:underline">{topic}</a>
          <span class="size-1.5 bg-accent" aria-hidden="true" />
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </p>
        <h1 class="rise mt-6 text-display-lg" style="--i:1">{title}</h1>
        <p class="rise mt-6 max-w-3xl text-lead text-muted" style="--i:2">{description}</p>
        <div class="rise mt-8 flex flex-wrap items-center justify-between gap-4" style="--i:3">
          <Byline names={names} />
          <button type="button" class="btn btn-ghost btn-sm" aria-haspopup="dialog" data-share-open hidden>
            <Icon name="social-share" class="size-3.5" />
            <span>Share</span>
          </button>
        </div>
      </div>
      <figure class="rise mt-12 lg:mt-16" style="--i:4">
        <div class="aspect-[16/9] overflow-hidden bg-sunken">
        <Image
          src={cover}
          alt={coverAlt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1400px) 1344px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
        />
        </div>
        {
          coverCredit && (
            <figcaption class="mono-meta mt-3">
              Photo: <a href={coverCredit.url} class="hover:text-ink hover:underline">{coverCredit.name}</a>
            </figcaption>
          )
        }
      </figure>
    </header>

    <div class="shell grid gap-12 py-14 lg:grid-cols-12 lg:gap-8 lg:py-20">
      <aside class="lg:col-span-3">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          {
            toc.length > 1 && (
              <nav aria-labelledby="toc-title" class="hidden lg:block">
                <p id="toc-title" class="text-sm text-muted">On this page</p>
                <ol class="toc mt-4 text-[0.9375rem]">
                  {toc.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`} class="toc-link" data-toc={heading.slug}>
                        {heading.text}
                      </a>
                      {heading.children.length > 0 && (
                        <ol class="toc toc-sub text-sm">
                          {heading.children.map((child) => (
                            <li>
                              <a href={`#${child.slug}`} class="toc-link" data-toc={child.slug}>
                                {child.text}
                              </a>
                            </li>
                          ))}
                        </ol>
                      )}
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <button type="button" class="btn btn-ghost btn-sm hidden lg:mt-10 lg:inline-flex" aria-haspopup="dialog" data-share-open hidden>
            <Icon name="social-share" class="size-3.5" />
            <span>Share this post</span>
          </button>
        </div>
      </aside>

      <div class="min-w-0 lg:col-span-7 lg:col-start-5">
        <div class="prose" data-prose>
          <Content />
        </div>

        {
          (tags.length > 0 || updated) && (
            <div class="mt-14 flex flex-wrap items-center gap-2">
              {tags.map((tag) => (
                <span class="bg-sunken px-3 py-1.5 font-mono text-[0.8rem]">{tag}</span>
              ))}
              {updated && (
                <span class="mono-meta ml-auto">
                  Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                </span>
              )}
            </div>
          )
        }

        {cta !== false && <PostCta {...cta} />}
        <AuthorCard names={names} />

        {
          (newer || older) && (
            <nav aria-label="More posts" class="mt-12 grid gap-8 border-t border-line pt-8 sm:grid-cols-2">
              {older ? (
                <a href={postHref(older)} class="group">
                  <span class="flex items-center gap-2 text-sm text-muted">
                    <Icon name="arrow-left" class="size-3" /> Previous
                  </span>
                  <span class="mt-2 block font-medium group-hover:text-accent-ink">{older.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {newer && (
                <a href={postHref(newer)} class="group sm:text-right">
                  <span class="flex items-center gap-2 text-sm text-muted sm:justify-end">
                    Next <Icon name="arrow-right" class="size-3" />
                  </span>
                  <span class="mt-2 block font-medium group-hover:text-accent-ink">{newer.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </div>
  </article>

  <ShareSheet title={title} url={url} />

  {
    related.length > 0 && (
      <section class="bg-sunken py-20 lg:py-28" aria-labelledby="related-title">
        <div class="shell">
          <h2 id="related-title" class="text-display-md">Keep reading</h2>
          <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>

  /* One continuous rail; the active link paints its own segment over it. */
  .toc {
    box-shadow: inset 1px 0 0 var(--line);
  }

  /* Sub-headings share the parent rail and step in, so there is one line only. */
  .toc-sub {
    box-shadow: none;
  }

  .toc-sub .toc-link {
    padding: 0.3rem 0 0.3rem 2rem;
  }

  .toc-link {
    position: relative;
    display: block;
    padding: 0.4rem 0 0.4rem 1rem;
    color: var(--muted);
    transition: color 0.2s;
  }

  .toc-link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .toc-link:hover {
    color: var(--ink);
  }

  .toc-link[aria-current] {
    color: var(--ink);
  }

  .toc-link[aria-current]::before {
    transform: scaleY(1);
  }

  .read-progress {
    transform: scaleX(0);
    transition: top 0.45s var(--ease-out-expo);
  }

  :global(html[data-header-hidden]) .read-progress {
    top: 0;
  }

  @supports (animation-timeline: scroll()) {
    .read-progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  const progress = document.querySelector<HTMLElement>("[data-progress]");
  if (progress && !CSS.supports("animation-timeline: scroll()")) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const targets = links
    .map((link) => document.getElementById(link.dataset.toc ?? ""))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length) {
    const setActive = () => {
      const offset = window.innerHeight * 0.3;
      let current = targets[0];
      for (const target of targets) {
        if (target.getBoundingClientRect().top - offset <= 0) current = target;
      }
      links.forEach((link) =>
        link.dataset.toc === current.id ? link.setAttribute("aria-current", "location") : link.removeAttribute("aria-current"),
      );
    };
    setActive();
    window.addEventListener("scroll", setActive, { passive: true });
  }

  if (navigator.clipboard) {
    document.querySelectorAll<HTMLPreElement>("[data-prose] pre.astro-code").forEach((pre) => {
      const wrap = document.createElement("div");
      wrap.className = "code-block";
      pre.replaceWith(wrap);
      wrap.append(pre);
      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy";
      button.textContent = "Copy";
      wrap.append(button);
      button.addEventListener("click", async () => {
        const code = pre.textContent ?? "";
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied";
        window.setTimeout(() => (button.textContent = "Copy"), 1600);
      });
    });
  }
</script>
