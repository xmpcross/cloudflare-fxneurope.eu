---
import { Image } from "astro:assets";
import Dither from "@/components/ui/Dither.astro";
import Icon from "@/components/ui/Icon.astro";
import { careers } from "@/config/careers";
import BaseLayout from "@/layouts/BaseLayout.astro";

const teams = [...new Set(careers.roles.map((role) => role.team))];
const teamId = (team: string) => team.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<BaseLayout title="Careers" description={careers.lead}>
  <section class="shell pt-14 pb-12 lg:pt-20 lg:pb-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <h1 class="rise text-display-xl lg:col-span-8">{careers.title}</h1>
      <div class="lg:col-span-4 lg:pb-3">
        <p class="rise text-lead text-muted" style="--i:1">{careers.lead}</p>
        <a href="#roles" class="rise btn btn-accent mt-8" style="--i:2">
          <span>See open roles</span>
          <Icon name="arrow-up-right" class="pixel-arrow" />
        </a>
      </div>
    </div>
  </section>

  <div class="shell">
    <div class="rise relative grid overflow-hidden lg:grid-cols-12" style="--i:3" data-dither-host>
      <Dither scene="silk" tone="ember" seed={12} speed={0.6} interactive class="absolute! inset-0" />
      <dl class="relative grid gap-2 p-4 sm:grid-cols-3 sm:p-8 lg:col-span-5 lg:grid-cols-1 lg:content-center lg:p-10">
        {
          careers.facts.map((fact) => (
            <div class="flex flex-col bg-page/95 p-5">
              <dt class="order-2 text-muted">{fact.label}</dt>
              <dd class="order-1 mb-1 text-4xl tracking-[-0.05em]">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="relative aspect-[3/2] lg:col-span-7 lg:aspect-auto lg:min-h-[34rem]">
        <Image
          src={careers.photo}
          alt={careers.photoAlt}
          widths={[640, 960, 1400]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          loading="eager"
          class="absolute inset-0 size-full object-cover"
        />
      </div>
    </div>
  </div>

  <section class="py-20 lg:py-32" aria-labelledby="values-title">
    <div class="shell">
      <h2 id="values-title" class="reveal max-w-2xl text-display-md">How we work</h2>
      <ol class="mt-12 grid gap-2 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
        {
          careers.values.map((value, i) => (
            <li class="reveal flex min-h-64 flex-col bg-surface p-6 lg:p-7">
              <span class="grid size-8 place-items-center bg-sunken font-mono text-sm">{i + 1}</span>
              <h3 class="mt-auto pt-10 text-lg font-medium tracking-tight">{value.title}</h3>
              <p class="mt-2 text-muted">{value.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-sunken py-20 lg:py-32" aria-labelledby="benefits-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-8">
      <h2 id="benefits-title" class="reveal text-display-md lg:col-span-4">What you get</h2>
      <ul class="grid gap-2 sm:grid-cols-2 lg:col-span-8">
        {
          careers.benefits.map((benefit) => (
            <li class="reveal flex gap-4 bg-page p-6">
              <span class="grid size-10 shrink-0 place-items-center bg-ink text-page">
                <Icon name={benefit.icon} class="size-[1.15rem]" />
              </span>
              <span>
                <span class="block font-medium">{benefit.title}</span>
                <span class="mt-1 block text-muted">{benefit.body}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="roles" class="py-20 lg:py-32" aria-labelledby="roles-title" data-roles>
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="roles-title" class="reveal text-display-md">
          {careers.rolesTitle}
          <span class="ml-3 text-muted">{careers.roles.length}</span>
        </h2>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by team" data-role-filters hidden>
          <button type="button" class="role-filter" aria-pressed="true" data-team="all">All</button>
          {
            teams.map((team) => (
              <button type="button" class="role-filter" aria-pressed="false" data-team={teamId(team)}>
                {team}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mt-12 grid gap-12 lg:mt-16">
        {
          teams.map((team) => (
            <div class="grid gap-2 lg:grid-cols-12 lg:gap-8" data-team-group={teamId(team)}>
              <h3 class="text-lg font-medium lg:col-span-3 lg:pt-5">{team}</h3>
              <ul class="grid gap-2 lg:col-span-9">
                {careers.roles
                  .filter((role) => role.team === team)
                  .map((role) => (
                    <li>
                      <a
                        href={role.applyUrl || undefined}
                        class="role-row group grid items-center gap-x-6 gap-y-1 bg-surface p-5 sm:grid-cols-[1fr_auto] lg:grid-cols-[minmax(0,1.8fr)_minmax(0,1fr)_7rem_1.5rem] lg:px-6"
                      >
                        <span class="text-[1.05rem] font-medium group-hover:text-accent-ink">{role.title}</span>
                        <span class="text-sm text-muted lg:text-base">{role.location}</span>
                        <span class="hidden text-muted lg:block">{role.type}</span>
                        <Icon name="arrow-up-right" class="pixel-arrow hidden text-accent-ink lg:inline-grid" />
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-16 sm:py-24" data-dither-host>
    <Dither scene="silk" tone="ember" seed={30} speed={0.6} interactive class="absolute! inset-0" />
    <div class="shell relative">
      <div class="reveal mx-auto flex max-w-3xl flex-col items-center gap-8 bg-page p-8 text-center sm:p-12 lg:p-14">
        <div>
          <h2 class="text-display-md">{careers.closing.title}</h2>
          <p class="mx-auto mt-4 max-w-md text-muted">{careers.closing.body}</p>
        </div>
        <a href={careers.closing.cta.href} class="btn btn-primary">
          <span>{careers.closing.cta.label}</span>
          <Icon name="arrow-up-right" class="pixel-arrow" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .role-row {
    transition: box-shadow 0.25s;
  }

  .role-row[href]:hover {
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .role-filter {
    padding: 0.6rem 1rem;
    font-size: 0.9375rem;
    background: var(--sunken);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .role-filter:hover {
    background: var(--line);
  }

  .role-filter[aria-pressed="true"] {
    background: var(--ink);
    color: var(--page);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-roles]");
  const filters = root?.querySelector<HTMLElement>("[data-role-filters]");

  if (root && filters) {
    filters.hidden = false;
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>("[data-team]")];
    const groups = [...root.querySelectorAll<HTMLElement>("[data-team-group]")];

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const team = button.dataset.team;
        buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        groups.forEach((group) => (group.hidden = team !== "all" && group.dataset.teamGroup !== team));
      }),
    );
  }
</script>
